---
interface Props {
  badge: string;
  name: string;
  tagline?: string;
  target?: string;
  schedule?: string;
  cost?: string;
  venue?: string;
  instructor?: string;
  note?: string;
}

const { badge, name, tagline, target, schedule, cost, venue, instructor, note } = Astro.props;

const rows = [
  { label: '対象', value: target },
  { label: '日程', value: schedule },
  { label: '参加費', value: cost },
  { label: '会場', value: venue },
  { label: '指導', value: instructor },
].filter((row) => row.value);
---
<article class="program">
  <div class="program-head">
    <div class="program-badge" aria-hidden="true">{badge}</div>
    <h2>{name}</h2>
  </div>
  {tagline && <p class="program-tagline">{tagline}</p>}
  {rows.length > 0 && (
    <dl class="program-rows">
      {rows.map((row) => (
        <>
          <dt>{row.label}</dt>
          <dd>{row.value}</dd>
        </>
      ))}
    </dl>
  )}
  {note && <p class="program-note">{note}</p>}
  <slot />
</article>

<style>
  .program {
    background: #fff;
    border-radius: 20px;
    padding: 28px;
    box-shadow: 0 8px 20px rgba(58, 51, 44, 0.06);
  }
  .program + .program {
    margin-top: 20px;
  }
  .program-head {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 12px;
  }
  .program-badge {
    width: 46px;
    height: 46px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.2rem;
    font-weight: 700;
    color: #fff;
    background: var(--color-primary-dark);
    flex-shrink: 0;
  }
  .program-head h2 {
    font-size: 1.1rem;
    font-weight: 700;
    margin: 0;
  }
  .program-tagline {
    color: var(--color-ink-muted);
    font-size: 0.9rem;
    margin: 0 0 16px;
    line-height: 1.7;
  }
  .program-rows {
    display: grid;
    grid-template-columns: 88px 1fr;
    gap: 8px 16px;
    margin: 0;
  }
  .program-rows dt {
    font-weight: 700;
    font-size: 0.82rem;
    color: var(--color-primary-dark);
  }
  .program-rows dd {
    margin: 0;
    font-size: 0.9rem;
  }
  .program-note {
    margin: 14px 0 0;
    font-size: 0.82rem;
    color: var(--color-ink-muted);
    border-left: 3px solid var(--color-surface);
    padding-left: 12px;
  }
  @media (max-width: 480px) {
    .program-rows {
      grid-template-columns: 1fr;
      gap: 2px 0;
    }
    .program-rows dd {
      margin-bottom: 6px;
    }
  }
</style>
