---
interface NewsLink {
  id: string;
  title: string;
  date: Date;
}

interface Props {
  badge: string;
  name: string;
  tagline?: string;
  target?: string;
  schedule?: string;
  cost?: string;
  venue?: string;
  instructor?: string;
  note?: string;
  latestNews?: NewsLink[];
}

const { badge, name, tagline, target, schedule, cost, venue, instructor, note, latestNews } = Astro.props;

const formatter = new Intl.DateTimeFormat('ja-JP', { year: 'numeric', month: 'long', day: 'numeric' });

const rows = [
  { label: '対象', value: target },
  { label: '日程', value: schedule },
  { label: '参加費', value: cost },
  { label: '会場', value: venue },
  { label: '指導', value: instructor },
].filter((row) => row.value);
---
<article class="program">
  <div class="program-head">
    <div class="program-badge" aria-hidden="true">{badge}</div>
    <h2>{name}</h2>
  </div>
  {tagline && <p class="program-tagline">{tagline}</p>}
  {rows.length > 0 && (
    <dl class="program-rows">
      {rows.map((row) => (
        <>
          <dt>{row.label}</dt>
          <dd>{row.value}</dd>
        </>
      ))}
    </dl>
  )}
  {note && <p class="program-note">{note}</p>}
  {latestNews && latestNews.length > 0 && (
    <div class="program-news">
      <p class="program-news-heading">最新のお知らせ</p>
      <ul>
        {latestNews.map((post) => (
          <li>
            <a href={`/news/${post.id}/`}>
              <span class="program-news-date">{formatter.format(post.date)}</span>
              {post.title}
            </a>
          </li>
        ))}
      </ul>
      <a class="program-news-all" href="/news/">お知らせ一覧をすべて見る →</a>
    </div>
  )}
  <slot />
</article>

<style>
  .program {
    background: #fff;
    border-radius: 20px;
    padding: 28px;
    box-shadow: 0 8px 20px rgba(58, 51, 44, 0.06);
  }
  .program + .program {
    margin-top: 20px;
  }
  .program-head {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 12px;
  }
  .program-badge {
    width: 46px;
    height: 46px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.2rem;
    font-weight: 700;
    color: #fff;
    background: var(--color-primary-dark);
    flex-shrink: 0;
  }
  .program-head h2 {
    font-size: 1.1rem;
    font-weight: 700;
    margin: 0;
  }
  .program-tagline {
    color: var(--color-ink-muted);
    font-size: 0.9rem;
    margin: 0 0 16px;
    line-height: 1.7;
  }
  .program-rows {
    display: grid;
    grid-template-columns: 88px 1fr;
    gap: 8px 16px;
    margin: 0;
  }
  .program-rows dt {
    font-weight: 700;
    font-size: 0.82rem;
    color: var(--color-primary-dark);
  }
  .program-rows dd {
    margin: 0;
    font-size: 0.9rem;
  }
  .program-note {
    margin: 14px 0 0;
    font-size: 0.82rem;
    color: var(--color-ink-muted);
    border-left: 3px solid var(--color-surface);
    padding-left: 12px;
  }
  .program-news {
    margin-top: 16px;
    padding: 14px 16px;
    background: var(--color-surface);
    border-radius: 14px;
  }
  .program-news-heading {
    margin: 0 0 8px;
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--color-primary-dark);
  }
  .program-news ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 6px;
  }
  .program-news a {
    text-decoration: none;
    color: var(--color-ink);
    font-size: 0.86rem;
  }
  .program-news a:hover {
    text-decoration: underline;
  }
  .program-news-date {
    color: var(--color-ink-muted);
    font-size: 0.78rem;
    margin-right: 8px;
  }
  .program-news-all {
    display: inline-block;
    margin-top: 10px;
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--color-primary-dark);
    text-decoration: none;
  }
  .program-news-all:hover {
    text-decoration: underline;
  }
  @media (max-width: 480px) {
    .program-rows {
      grid-template-columns: 1fr;
      gap: 2px 0;
    }
    .program-rows dd {
      margin-bottom: 6px;
    }
  }
</style>
