---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  photos: ImageMetadata[];
  alt: string;
}

const { photos, alt } = Astro.props;
---
<div class="gallery">
  {photos.map((photo, i) => (
    <Image src={photo} alt={`${alt}(写真${i + 1})`} width={320} height={240} loading="lazy" />
  ))}
</div>

<style>
  .gallery {
    margin-top: 16px;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));
    gap: 8px;
  }
  .gallery :global(img) {
    width: 100%;
    height: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: 12px;
  }
</style>
