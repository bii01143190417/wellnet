---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';

const posts = (await getCollection('news')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const formatter = new Intl.DateTimeFormat('ja-JP', { year: 'numeric', month: 'long', day: 'numeric' });
---
<Layout
  title="お知らせ | みんなのWell.net"
  description="みんなのWell.netからのお知らせ一覧です。"
>
  <section class="page-hero">
    <div class="container">
      <span class="page-badge">お知らせ</span>
      <h1>お知らせ</h1>
    </div>
  </section>

  <section class="container section">
    <ul class="post-list">
      {posts.map((post) => (
        <li>
          <a class="post-link" href={`/news/${post.id}/`}>
            {post.data.image && (
              <Image class="post-thumb" src={post.data.image} alt="" width={320} height={200} />
            )}
            <div class="post-text">
              <span class="post-category">{post.data.category}</span>
              <span class="post-date">{formatter.format(post.data.date)}</span>
              <h2>{post.data.title}</h2>
              <p>{post.data.excerpt}</p>
            </div>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <style>
    .page-hero {
      padding: 44px 0 36px;
    }
    .page-badge {
      display: inline-block;
      font-size: 0.8rem;
      font-weight: 700;
      color: var(--color-primary-dark);
      background: var(--color-surface);
      padding: 6px 14px;
      border-radius: 999px;
      margin-bottom: 16px;
    }
    .page-hero h1 {
      font-size: clamp(1.6rem, 1.2rem + 1.6vw, 2.2rem);
      font-weight: 700;
      margin: 0;
    }
    .section {
      padding: 8px 24px 48px;
    }
    .post-list {
      list-style: none;
      margin: 0;
      padding: 0;
      display: grid;
      gap: 16px;
    }
    .post-link {
      display: flex;
      align-items: center;
      gap: 20px;
      background: #fff;
      border-radius: 20px;
      padding: 16px;
      box-shadow: 0 8px 20px rgba(58, 51, 44, 0.06);
      text-decoration: none;
      color: var(--color-ink);
    }
    .post-thumb {
      flex: 0 0 auto;
      width: 140px;
      height: 88px;
      object-fit: cover;
      border-radius: 14px;
    }
    .post-text {
      min-width: 0;
    }
    @media (max-width: 560px) {
      .post-link {
        flex-direction: column;
        align-items: stretch;
      }
      .post-thumb {
        width: 100%;
        height: 160px;
      }
    }
    .post-category {
      display: inline-block;
      font-size: 0.74rem;
      font-weight: 700;
      color: var(--color-primary-dark);
      background: var(--color-surface);
      padding: 3px 10px;
      border-radius: 999px;
      margin-right: 10px;
    }
    .post-date {
      font-size: 0.8rem;
      color: var(--color-ink-muted);
    }
    .post-list h2 {
      font-size: 1.05rem;
      font-weight: 700;
      margin: 10px 0 8px;
    }
    .post-list p {
      font-size: 0.88rem;
      color: var(--color-ink-muted);
      margin: 0;
    }
  </style>
</Layout>
