---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import { withBase } from '../../utils/url';

const posts = (await getCollection('report')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const formatter = new Intl.DateTimeFormat('ja-JP', { year: 'numeric', month: 'long', day: 'numeric' });

function excerptOf(html: string, length = 60) {
  const text = html.replace(/<[^>]+>/g, '').trim();
  return text.length > length ? `${text.slice(0, length)}…` : text;
}
---
<Layout
  title="活動報告 | みんなのWell.net"
  description="みんなのWell.netの活動報告一覧です。"
>
  <section class="page-hero">
    <div class="container">
      <span class="page-badge">活動報告</span>
      <h1>活動報告</h1>
    </div>
  </section>

  <section class="container section">
    {posts.length === 0 ? (
      <div class="empty-card">
        <p>活動の様子は現在準備中です。今しばらくお待ちください。</p>
        <p class="note">最新のイベント情報は「お知らせ」でご案内しています。</p>
        <a class="cta" href={withBase('/news/')}>お知らせを見る</a>
      </div>
    ) : (
      <ul class="post-list">
        {posts.map((post) => (
          <li>
            <a class="post-link" href={withBase(`/report/${post.id}/`)}>
              {post.data.images[0] && (
                <Image class="post-thumb" src={post.data.images[0].url} alt="" width={320} height={200} />
              )}
              <div class="post-text">
                <span class="post-date">{formatter.format(post.data.date)}</span>
                <h2>{post.data.title}</h2>
                <p>{excerptOf(post.data.body)}</p>
              </div>
            </a>
          </li>
        ))}
      </ul>
    )}
  </section>

  <style>
    .page-hero {
      padding: 44px 0 36px;
    }
    .page-badge {
      display: inline-block;
      font-size: 0.8rem;
      font-weight: 700;
      color: var(--color-primary-dark);
      background: var(--color-surface);
      padding: 6px 14px;
      border-radius: 999px;
      margin-bottom: 16px;
    }
    .page-hero h1 {
      font-size: clamp(1.6rem, 1.2rem + 1.6vw, 2.2rem);
      font-weight: 700;
      margin: 0;
    }
    .section {
      padding: 8px 24px 48px;
    }
    .empty-card {
      max-width: 560px;
      margin: 0 auto;
      background: #fff;
      border-radius: 20px;
      padding: 32px;
      box-shadow: 0 8px 20px rgba(58, 51, 44, 0.06);
      text-align: center;
    }
    .empty-card p {
      font-size: 0.95rem;
      margin: 0 0 12px;
    }
    .note {
      color: var(--color-ink-muted);
      font-size: 0.88rem;
    }
    .cta {
      display: inline-block;
      background: var(--color-primary-dark);
      color: #fff;
      text-decoration: none;
      font-weight: 700;
      font-size: 0.9rem;
      padding: 12px 28px;
      border-radius: 999px;
      margin-top: 8px;
    }
    .post-list {
      list-style: none;
      margin: 0;
      padding: 0;
      display: grid;
      gap: 16px;
    }
    .post-link {
      display: flex;
      align-items: center;
      gap: 20px;
      background: #fff;
      border-radius: 20px;
      padding: 16px;
      box-shadow: 0 8px 20px rgba(58, 51, 44, 0.06);
      text-decoration: none;
      color: var(--color-ink);
    }
    .post-thumb {
      flex: 0 0 auto;
      width: 140px;
      height: 88px;
      object-fit: cover;
      border-radius: 14px;
    }
    .post-text {
      min-width: 0;
    }
    .post-date {
      font-size: 0.8rem;
      color: var(--color-ink-muted);
    }
    .post-list h2 {
      font-size: 1.05rem;
      font-weight: 700;
      margin: 6px 0 8px;
    }
    .post-list p {
      font-size: 0.88rem;
      color: var(--color-ink-muted);
      margin: 0;
    }
    @media (max-width: 560px) {
      .post-link {
        flex-direction: column;
        align-items: stretch;
      }
      .post-thumb {
        width: 100%;
        height: 160px;
      }
    }
  </style>
</Layout>
