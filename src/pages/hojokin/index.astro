---
import Layout from '../../layouts/Layout.astro';
---
<Layout
  title="補助金・助成金事業 | みんなのWell.net"
  description="法人・自治体などから助成金を得て、健康づくりのための事業を行っています。"
>
  <section class="page-hero">
    <div class="container">
      <span class="page-badge">補助金・助成金事業</span>
      <h1>助成金を活用した<br />健康づくり事業</h1>
    </div>
  </section>

  <section class="container section">
    <div class="content-card">
      <p>
        法人・自治体などから助成金を得て、健康づくりのための事業を行っています。
      </p>
      <p class="note">
        詳細は随時「お知らせ」にてご案内します。
      </p>
      <a class="cta" href="/news/">お知らせを見る</a>
    </div>
  </section>

  <style>
    .page-hero {
      padding: 44px 0 36px;
    }
    .page-badge {
      display: inline-block;
      font-size: 0.8rem;
      font-weight: 700;
      color: var(--color-primary-dark);
      background: var(--color-surface);
      padding: 6px 14px;
      border-radius: 999px;
      margin-bottom: 16px;
    }
    .page-hero h1 {
      font-size: clamp(1.6rem, 1.2rem + 1.6vw, 2.2rem);
      font-weight: 700;
      margin: 0;
      line-height: 1.5;
    }
    .section {
      padding: 8px 24px 48px;
      max-width: 640px;
      margin: 0 auto;
    }
    .content-card {
      background: #fff;
      border-radius: 20px;
      padding: 32px;
      box-shadow: 0 8px 20px rgba(58, 51, 44, 0.06);
    }
    .content-card p {
      font-size: 0.95rem;
      line-height: 1.9;
      margin: 0 0 16px;
    }
    .note {
      color: var(--color-ink-muted);
      font-size: 0.88rem;
    }
    .cta {
      display: inline-block;
      background: var(--color-primary-dark);
      color: #fff;
      text-decoration: none;
      font-weight: 700;
      font-size: 0.9rem;
      padding: 12px 28px;
      border-radius: 999px;
      margin-top: 8px;
    }
  </style>
</Layout>
