---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;

const nav = [
  { label: '団体紹介', href: '/about/' },
  { label: '子育て支援事業', href: '/kosodate/' },
  { label: '健康づくり推進事業', href: '/kenko/' },
  { label: 'お知らせ', href: '/news/' },
  { label: 'お問い合わせ', href: '/contact/' },
];

const footerNav = [
  { label: '受託事業', href: '/trustee/' },
  { label: '講座・講師派遣事業', href: '/kouza/' },
  { label: '補助金・助成金事業', href: '/hojokin/' },
  { label: '活動報告', href: '/report/' },
];
---
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Quicksand:wght@700&display=swap" rel="stylesheet" />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="container nav-row">
        <a class="logo" href="/">みんなの<em>Well.net</em></a>
        <nav class="nav-links">
          {nav.map((item) => <a href={item.href}>{item.label}</a>)}
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <nav class="footer-nav">
          {footerNav.map((item) => <a href={item.href}>{item.label}</a>)}
        </nav>
        <div class="footer-row">
          <span>〒590-0025 大阪府堺市堺区向陵東町1丁2番2号</span>
          <span>TEL 090-1226-9028</span>
        </div>
      </div>
    </footer>

    <style>
      .site-header {
        padding: 16px 0;
      }
      .nav-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 14px;
        flex-wrap: wrap;
      }
      .logo {
        font-family: var(--font-display);
        font-weight: 700;
        font-size: 1.2rem;
        color: var(--color-primary-dark);
        text-decoration: none;
        letter-spacing: -0.01em;
      }
      .logo em {
        font-style: normal;
        color: var(--color-ink);
        font-weight: 500;
        font-size: 0.85em;
      }
      .nav-links {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
      }
      .nav-links a {
        text-decoration: none;
        color: var(--color-ink);
        font-size: 0.88rem;
        font-weight: 700;
        padding: 9px 16px;
        border-radius: 999px;
        background: var(--color-surface);
      }

      .site-footer {
        padding: 24px 0;
        background: var(--color-surface);
        font-size: 0.85rem;
        color: var(--color-ink-muted);
      }
      .footer-nav {
        display: flex;
        flex-wrap: wrap;
        gap: 6px 18px;
        margin-bottom: 16px;
        padding-bottom: 16px;
        border-bottom: 1px solid #ffe3ce;
      }
      .footer-nav a {
        color: var(--color-ink-muted);
        text-decoration: none;
        font-size: 0.8rem;
      }
      .footer-nav a:hover {
        text-decoration: underline;
      }
      .footer-row {
        display: flex;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 8px;
      }
    </style>
  </body>
</html>
